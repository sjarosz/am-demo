AM_URL=https://am.jrsz.org:8443/am
AM_COOKIE_DOMAIN=jrsz.org
AM_ADMIN_PASSWORD=changeit
AM_KEYSTORE_PASSWORD=changeit
APP_KEYSTORE_PASSWORD=changeit
TRUSTSTORE_PASSWORD=changeit
DS_ROOT_PASSWORD=changeit
DS_MONITOR_PASSWORD=changeit
DS_AM_PROFILE_PASSWORD=changeit

# Demo realm end-user used by OAuth/OIDC smoke tests.
# Password must avoid words in the DS dictionary/common-passwords validators.
# "Jrsz" is a project-specific token (not a dictionary word) so it passes.
# Format: uppercase + lowercase + digit + two special chars, 10+ chars.
DEMO_USER_NAME=demo-user
DEMO_USER_PASSWORD='Jrsz$2025!'
IG_AGENT_ID=ig_agent_alpha
IG_AGENT_PASSWORD=igagent-changeit-01
IG_BASE_URL=https://ig.jrsz.org
AM_REALM=/alpha
AM_REALM_PATH=realms/root/realms/alpha

# app4 PKCE demo overrides. Defaults target the local lab AM alpha realm.
# Point app4 at a different AM (or a non-AM OIDC provider) by setting these.
# OIDC_ISSUER_URL is the issuer; app4 appends /.well-known/openid-configuration.
# Leave APP4_CLIENT_SECRET blank for a public PKCE client (lab default).
# When set, app4 sends client_secret_basic on the token call (still with PKCE).
APP4_BASE_URL=https://app4.jrsz.org
APP4_OIDC_ISSUER_URL=https://am.jrsz.org:8443/am/oauth2/realms/root/realms/alpha
APP4_CLIENT_ID=demo-pkce-app
APP4_CLIENT_SECRET=

# Login Widget demo (app5) against AM /alpha.
LOGIN_WIDGET_BASE_URL=https://app5.jrsz.org
LOGIN_WIDGET_CLIENT_ID=sdkPublicClient
LOGIN_WIDGET_JOURNEY=sdkUsernamePasswordJourney
LOGIN_WIDGET_CORS_CONFIG_NAME=LoginWidget

# app7 SAML v2.0 cross-domain federation console (jrsz.org <-> jrsz.net).
# The two AM stacks are federated in the /alpha realm: each hosts one dual-role
# (IDP + SP) entity and imports the other as a remote provider, joined by the
# `jrsz-federation` circle of trust. AM is both the IDP and the SP; app7 only
# launches AM's built-in idpssoinit/spssoinit endpoints for the four
# IDP/SP-init permutations and reports the resulting federated AM session.
# Auto-federation on `uid` resolves the assertion to the local demo-user.
# These are configured on the running AM via REST (see docs/saml-federation.md),
# not via amster bootstrap.
APP7_BASE_URL=https://app7.jrsz.org
SAML_REALM=/alpha
SAML_REALM_PATH=realms/root/realms/alpha
ORG_AM_BASE_URL=https://am.jrsz.org:8443/am
COM_AM_BASE_URL=https://am.jrsz.net:9443/am
ORG_ENTITY_ID=https://am.jrsz.org:8443/am/jrsz-org
COM_ENTITY_ID=https://am.jrsz.net:9443/am/jrsz-com
ORG_IDP_METAALIAS=/alpha/idp-org
ORG_SP_METAALIAS=/alpha/sp-org
COM_IDP_METAALIAS=/alpha/idp-com
COM_SP_METAALIAS=/alpha/sp-com

# Cross-AM OIDC social login (jrsz.org <-> jrsz.net). Each /alpha realm hosts a
# confidential OIDC client the PARTNER uses (social-<partner>-rp) and a Social
# Identity Provider Service entry (<partner>Provider) + the social-only
# SocialLogin journey. Both stacks must share these client secrets so the OP
# registration and the consumer provider config agree. Provisioned over REST by
# config/amster/social (reuses ORG_AM_BASE_URL / COM_AM_BASE_URL above).
SOCIAL_ORG_RP_SECRET=org-social-secret-changeit
SOCIAL_COM_RP_SECRET=com-social-secret-changeit

# OAuth2/OIDC custom-script tester (app8, org-only). A confidential OIDC client
# against the isolated /scriptlab realm whose OAuth2 provider wires six PingAM
# sample scripts (OIDC claims, access-token modification, evaluate-scope,
# validate-scope, authorize-endpoint data provider, may-act). Every custom token
# element is named with a star emoji. Provisioned by config/amster/oauth2-scripts.
APP8_BASE_URL=https://app8.jrsz.org
SCRIPTLAB_REALM_PATH=realms/root/realms/scriptlab
SCRIPTLAB_CLIENT_ID=scriptlab-rp
SCRIPTLAB_CLIENT_SECRET=scriptlab-secret-changeit
APP8_SESSION_SECRET=scriptlab-changeit-changeit

# SAML2 custom-script tester (app9, BOTH stacks). A genuine cross-AM federation
# isolated in the /samllab realm: org hosts the IdP (samllab-idp) with the IDP
# Attribute Mapper + NameID Mapper scripts; com hosts the SP (samllab-sp) with
# the SP Adapter script. Every custom assertion/session element is named with a
# star emoji. Provisioned by config/amster/saml-scripts (per stack).
APP9_BASE_URL=https://app9.jrsz.org
SAMLLAB_REALM=/samllab
SAMLLAB_REALM_PATH=realms/root/realms/samllab
SAMLLAB_IDP_ENTITY_ID=https://am.jrsz.org:8443/am/samllab-idp
SAMLLAB_SP_ENTITY_ID=https://am.jrsz.net:9443/am/samllab-sp
SAMLLAB_IDP_METAALIAS=/samllab/idp
SAMLLAB_SP_METAALIAS=/samllab/sp

# app6 session-timeout / logout / OIDC SLO test console. Runs against a dedicated
# short-timeout realm (timeout-test) with two OIDC RPs (RP C confidential, RP D
# public PKCE) that register back-channel logout URIs, plus an API E resource
# server. The timeout-test realm + RP clients are created by the oauth2-demo
# bootstrap. Tune the short session/token values with scripts/set-timeout-profile.sh.
APP6_BASE_URL=https://app6.jrsz.org
APP6_OIDC_ISSUER_URL=https://am.jrsz.org:8443/am/oauth2/realms/root/realms/timeout-test
TIMEOUT_REALM=/timeout-test
TIMEOUT_REALM_PATH=realms/root/realms/timeout-test
RP_C_CLIENT_ID=rp-c-app
RP_C_CLIENT_SECRET=rp-c-secret-changeit
RP_D_CLIENT_ID=rp-d-app
RP_D_CLIENT_SECRET=
# Default short non-production timeouts (minutes for AM, seconds for tokens),
# applied to the timeout-test realm + RP clients by scripts/set-timeout-profile.sh.
AM_IDLE_MINUTES=6
AM_MAX_MINUTES=20
AT_TTL_SECONDS=300
RT_TTL_SECONDS=1800
ID_TTL_SECONDS=300
# timeout-test SSO session storage: true => client-side (stateless JWT) sessions,
# false => server-side (CTS) sessions. app6's "AM type" chip reflects this.
TIMEOUT_REALM_STATELESS=true
# Realm-local test user created in timeout-test by the bootstrap (so logins create
# the session IN that realm). Leave TIMEOUT_TEST_USER empty to skip user creation.
TIMEOUT_TEST_USER=tt-user
TIMEOUT_TEST_USER_PASSWORD=St@telessTest-2026-xyz

# Amster one-shot bootstrap toggles (used by docker compose --profile bootstrap).
# Set any value to "false" to skip that step on a bootstrap run.
BOOTSTRAP_OAUTH2_DEMO_CONFIG=true
BOOTSTRAP_DEMO_USER=true
BOOTSTRAP_LOGIN_WIDGET_CONFIG=true
# Import the MFA / TOTP / Passkeys / Passwordless journeys into the alpha realm.
BOOTSTRAP_JOURNEYS=true
# Provision the cross-domain SAML federation (jrsz.org <-> jrsz.net).
BOOTSTRAP_SAML=true
# Provision cross-AM OIDC social login (each AM is the other's social provider).
BOOTSTRAP_SOCIAL=true
# Provision the OAuth2/OIDC custom-script lab (/scriptlab realm + app8 client). Org-only.
BOOTSTRAP_OAUTH2_SCRIPTS=true
# Provision the SAML2 custom-script lab (/samllab realm + app9). Runs per stack
# (org hosts the IdP, com hosts the SP) to form a genuine cross-AM federation.
BOOTSTRAP_SAML_SCRIPTS=true
# Provision the /bravo OIDC realm whose id_tokens are signed by a dedicated cert
# (secrets/oidc-signing/) registered in the horizon AIC instance as a Trusted JWT
# Issuer for the RFC 7523 JWT-bearer grant. See config/amster/oidc-horizon/.
BOOTSTRAP_OIDC_HORIZON=true

# Gateway trusts AM and the backend apps through this PKCS12 truststore.
# Required file mounts:
#   secrets/truststores/truststore.p12
#   secrets/passwords/gateway/truststore.pass
#
# Gateway TLS listener expects:
#   secrets/tls/gateway/gateway.server.keypair.pem
#
# AM expects:
#   secrets/tls/am/am.p12
#
# DS expects:
#   secrets/tls/ds/keystore
#   secrets/tls/ds/keystore.pin
#
# Each backend app expects:
#   secrets/tls/app1/app1.p12
#   secrets/tls/app2/app2.p12
#   secrets/tls/app3/app3.p12
#
# Host DNS or /etc/hosts must resolve these public names to the Docker host:
#   am.jrsz.org
#   ig.jrsz.org
#   app1.jrsz.org
#   app2.jrsz.org
#   app3.jrsz.org
#   app4.jrsz.org
#   app5.jrsz.org
#   app6.jrsz.org
#   app7.jrsz.org
#
# SAML federation (app7) also needs the partner AM + console host reachable
# from the browser:
#   am.jrsz.net
#   app7.jrsz.net
#
# ---------------------------------------------------------------------------
# Parallel jrsz.net stack (compose.com.yaml, included from compose.yaml)
# ---------------------------------------------------------------------------
# A full independent twin of every service runs alongside this one. Its runtime
# values live in `.env.com` (already committed with lab defaults). The jrsz.net
# services publish non-conflicting host ports:
#   am.jrsz.net -> 9443   (AM also listens on 9443 inside the container)
#   ig.jrsz.net -> 8444   (gateway listens on 8443 inside the container)
# Generate jrsz.net TLS material (same CA) and gateway config with:
#   ./scripts/generate-tls.sh         # emits secrets/tls/*-com
#   ./scripts/render-com-config.sh    # emits config/gateway-com
# Bootstrap the jrsz.net AM with:
#   docker compose --profile bootstrap up --abort-on-container-exit amster-bootstrap-com
# Shared passwords interpolate from THIS .env; jrsz.net-specific URLs/cookie
# domain come from .env.com.

# --- Let's Encrypt (optional; scripts/le-cert.sh, docs/tls-letsencrypt.md) ---
# Account e-mail for Let's Encrypt (expiry notices are no longer sent, but required by ACME).
#LE_EMAIL=you@example.com
# After `scripts/le-cert.sh issue --domain jrsz.org && scripts/le-cert.sh install --domain jrsz.org`,
# uncomment to switch the browser-facing org endpoints (am.jrsz.org:8443, ig.jrsz.org:443).
# Values MUST start with ./ (a bare path is treated by Compose as a named volume).
# Then: docker compose up -d am gateway && docker compose restart am-com
#AM_TLS_DIR=./secrets/tls/le/jrsz.org/am
#GATEWAY_TLS_DIR=./secrets/tls/le/jrsz.org/gateway
# Same for the jrsz.net (com) stack after `... --domain jrsz.net` (am.jrsz.net:9443, ig.jrsz.net:8444).
# Then: docker compose up -d am-com gateway-com && docker compose restart am
#AM_COM_TLS_DIR=./secrets/tls/le/jrsz.net/am
#AM_COM_KEYSTORE_FILE=/run/secrets/tls/am.p12
#GATEWAY_COM_TLS_DIR=./secrets/tls/le/jrsz.net/gateway

# --- jrsz.net /bravo -> bonaire05 (PingOne AIC) RFC 7523 JWT bearer (docs/bonaire05-jwt-bearer.md) ---
# The jrsz.net stack's /bravo realm issues RS256 JWT access tokens (aud = bonaire05 token endpoint,
# preferred_username = uid) that bonaire05 accepts as jwt-bearer assertions via a Trusted JWT Issuer.
# Turn off with BOOTSTRAP_OIDC_BONAIRE=false. Identity must exist by userName in both tenants:
#BONAIRE_DEMO_USER=acarter
#BONAIRE_DEMO_USER_PASSWORD=<same password as in bonaire05>
#BONAIRE_PORTAL_CLIENT_ID=bonaire-portal
#BONAIRE_PORTAL_CLIENT_SECRET=bonaire-portal-secret-changeit
#BONAIRE_PORTAL_SCOPES=openid profile email a2a:invoke
#REMOTE_AS_TOKEN_ENDPOINT=https://openam-bonaire05.forgeblocks.com:443/am/oauth2/realms/root/realms/alpha/access_token
# bonaire05-side client (grant jwt-bearer, client_secret_post) used by scripts/smoke_jwt_bearer_bonaire05.sh:
#BONAIRE_JWT_CLIENT_ID=jrsz-concierge
#BONAIRE_JWT_CLIENT_SECRET=<its secret>
#BONAIRE_JWT_SCOPE=a2a:invoke

# --- Remote Connector Server (rcs.jrsz.net) -> bonaire05 LDAP onboarding (docs/bonaire05-ldap-onboarding.md) ---
# Set these in .env.com (the rcs-com service uses env_file: .env.com). ds.jrsz.net is the
# authoritative source: scripts/provision_bonaire05_ldap_app.py registers the RCS + OAuth2 client
# in bonaire05, creates the LDAP application/connector and the systemLdap -> alpha_user mapping.
#RCS_URL=wss://openam-bonaire05.forgeblocks.com/openicf/0
#RCS_NAME=jrsz-rcs
#RCS_TOKEN_ENDPOINT=https://openam-bonaire05.forgeblocks.com:443/am/oauth2/realms/root/realms/alpha/access_token
#RCS_CLIENT_ID=RCSjrsz-rcs
# secret lives in secrets/rcs/client-secret (gitignored), not in .env.com
#RCS_SCOPE=fr:idm:*
#RCS_LDAP_HOST=ds.jrsz.net
#RCS_LDAP_PORT=1636
#RCS_LDAP_BIND_DN=uid=am-identity-bind-account,ou=admins,ou=identities
#RCS_LDAP_BIND_PASSWORD=changeit
#RCS_LDAP_BASE_DN=ou=identities
#RCS_LDAP_USERS_DN=ou=people,ou=identities
#BONAIRE_LDAP_APP_NAME=jrsz-ldap
#BOOTSTRAP_LDAP_ONBOARDING=true      # reset-stack.sh replays scripts/setup-ldap-onboarding.sh
